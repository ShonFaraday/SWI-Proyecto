@model WebProyecto.Models.Membresia

@{
    ViewData["Title"] = "Nueva Membresía";
}

<h2>Nueva Membresía</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="ID_M"></label>
        <input asp-for="ID_M" class="form-control" />
        <span asp-validation-for="ID_M" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Descripcion"></label>
        <input asp-for="Descripcion" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Max_Libros_Prestamo"></label>
        <input asp-for="Max_Libros_Prestamo" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Dias_Prestamo"></label>
        <input asp-for="Dias_Prestamo" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Costo"></label>
        <input asp-for="Costo" class="form-control" />
    </div>

    <br />
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
