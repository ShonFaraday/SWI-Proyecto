@model WebProyecto.Models.Membresia

@{
    ViewData["Title"] = "Editar Membresía";
}

<h2>Editar Membresía</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ID_M" />

    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Descripcion"></label>
        <input asp-for="Descripcion" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Max_Libros_Prestamo"></label>
        <input asp-for="Max_Libros_Prestamo" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Dias_Prestamo"></label>
        <input asp-for="Dias_Prestamo" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Costo"></label>
        <input asp-for="Costo" class="form-control" />
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
