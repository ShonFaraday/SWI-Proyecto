@model WebProyecto.Models.Membresia

@{
    ViewData["Title"] = "Eliminar Membresía";
}

<h2>Eliminar Membresía</h2>

<h4>¿Estás seguro que deseas eliminar esta membresía?</h4>

<div>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Costo</dt>
        <dd class="col-sm-9">@Model.Costo</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ID_M" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
