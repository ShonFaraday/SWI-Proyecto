@model WebProyecto.Models.Membresia

@{
    ViewData["Title"] = "Eliminar Membresía";
}

<h1>Eliminar Membresía</h1>

<h3>¿Estás seguro que deseas eliminar esta membresía?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">@Model.ID_M</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>

        <dt class="col-sm-2">Max Libros</dt>
        <dd class="col-sm-10">@Model.Max_Libros_Prestamo</dd>

        <dt class="col-sm-2">Días Préstamo</dt>
        <dd class="col-sm-10">@Model.Dias_Prestamo</dd>

        <dt class="col-sm-2">Costo</dt>
        <dd class="col-sm-10">@Model.Costo.ToString("C")</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="ID_M" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

